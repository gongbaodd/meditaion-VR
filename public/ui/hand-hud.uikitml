<!--
  Paused-session hand menu, shown beside the raised palm while a session is paused.
  The scene node scales it to ~18 cm wide. Ids: hh-title, hh-time, hh-resume, hh-end.
-->
<style>
  .root {
    flex-direction: column;
    width: 360px;
    padding-top: 20px;
    padding-bottom: 20px;
    padding-left: 20px;
    padding-right: 20px;
    gap: 14px;
    border-radius: 36px;
    border-width: 2px;
    border-color: #3a3d43;
    background-color: #15171a;
  }

  .head {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-left: 12px;
    padding-right: 12px;
  }

  .title {
    color: #eceef1;
    font-size: 30px;
    font-weight: bold;
  }

  .time {
    color: #c9ccd2;
    font-size: 28px;
  }

  .primary {
    height: 84px;
    align-items: center;
    justify-content: center;
    border-radius: 42px;
    background-color: #f1d9a8;
    color: #1a1712;
    font-size: 36px;
    font-weight: bold;
    text-align: center;
    cursor: pointer;
  }

  .primary:hover {
    background-color: #ffe9bf;
  }

  .ghost {
    height: 76px;
    align-items: center;
    justify-content: center;
    border-radius: 38px;
    border-width: 2px;
    border-color: #4a4e56;
    background-color: #24272c;
    color: #eceef1;
    font-size: 30px;
    text-align: center;
    cursor: pointer;
  }

  .ghost:hover {
    border-color: #f1d9a8;
  }
</style>
<div class="root">
  <div class="head">
    <span id="hh-title" class="title">Paused</span>
    <span id="hh-time" class="time">5:00</span>
  </div>
  <span id="hh-resume" class="primary">Resume</span>
  <span id="hh-end" class="ghost">End session</span>
</div>
